#!/usr/bin/env sh
# Gradle wrapper shell script (Unix)
# Generated for ServerRules project

set -e

GRADLE_APP_NAME="Gradle"
GRADLE_APP_DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'
DIRNAME=$(dirname "$0")
CLASSPATH="$DIRNAME/gradle/wrapper/gradle-wrapper.jar"

# OS specific support
cygwin=false
darwin=false
nonstop=false
case "`uname`" in
  CYGWIN* ) cygwin=true ;;
  Darwin* ) darwin=true ;;
  NONSTOP* ) nonstop=true ;;
esac

if [ -z "$JAVA_HOME" ] ; then
  if [ -r /etc/gentoo-release ] ; then
    JAVA_HOME=$(java -XshowSettings:vm -version 2>&1 | awk '/java.home/{print $3}')
  fi
fi

if [ -z "$JAVA_HOME" ] ; then
  JAVACMD="java"
else
  JAVACMD="$JAVA_HOME/bin/java"
fi

exec "$JAVACMD" $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS \
  "-Dorg.gradle.appname=$GRADLE_APP_NAME" \
  -classpath "$CLASSPATH" \
  org.gradle.wrapper.GradleWrapperMain \
  "$@"
